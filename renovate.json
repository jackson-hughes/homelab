{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "ignorePaths": [],
  "minimumReleaseAge": "5 days",
  "internalChecksFilter": "strict",
  "flux": {
    "managerFilePatterns": ["/kubernetes/.+\\.ya?ml$/"]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "KubeVirt, CDI, and Gateway API ship release YAML, not charts; bump the version pinned in the kustomize remote resource URLs",
      "managerFilePatterns": [
        "/^kubernetes/infrastructure/controllers/(kubevirt|cdi|gateway-api)/kustomization\\.yaml$/"
      ],
      "matchStrings": [
        "https://github\\.com/(?<depName>kubevirt/kubevirt|kubevirt/containerized-data-importer|kubernetes-sigs/gateway-api)/releases/download/(?<currentValue>v[\\d.]+)/"
      ],
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "Talos OS pin and factory installer image tag (must stay in lockstep; CI enforces agreement)",
      "managerFilePatterns": [
        "/^infra/metal/talos-version$/",
        "/^infra/metal/patches/machine-install-image\\.yaml$/"
      ],
      "matchStrings": [
        "^(?<currentValue>v\\d+\\.\\d+\\.\\d+)\\s*$",
        "factory\\.talos\\.dev/installer/[0-9a-f]{64}:(?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "siderolabs/talos"
    }
  ]
}
