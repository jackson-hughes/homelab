{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "ignorePaths": [],
  "minimumReleaseAge": "5 days",
  "internalChecksFilter": "strict",
  "flux": {
    "managerFilePatterns": ["/kubernetes/.+\\.ya?ml$/"]
  },
  "kubernetes": {
    "managerFilePatterns": ["/kubernetes/.+\\.ya?ml$/"]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Flux itself is installed by flux-operator from the FluxInstance; Renovate's flux manager only reads gotk manifests, so bump spec.distribution.version here (kept exact because validate-kubernetes.sh resolves the CRD schemas from it)",
      "managerFilePatterns": [
        "/^kubernetes/clusters/homelab/flux-system/flux-instance\\.yaml$/"
      ],
      "matchStrings": [
        "distribution:[\\s\\S]*?version: \"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "fluxcd/flux2",
      "extractVersionTemplate": "^v(?<version>.+)$"
    },
    {
      "customType": "regex",
      "description": "KubeVirt, CDI, and Gateway API ship release YAML, not charts; bump the version pinned in the kustomize remote resource URLs",
      "managerFilePatterns": [
        "/^kubernetes/infrastructure/controllers/(kubevirt|cdi|gateway-api)/kustomization\\.yaml$/"
      ],
      "matchStrings": [
        "https://github\\.com/(?<depName>kubevirt/kubevirt|kubevirt/containerized-data-importer|kubernetes-sigs/gateway-api)/releases/download/(?<currentValue>v[\\d.]+)/"
      ],
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "Talos OS pin in topf.yaml. Do not Renovate kubernetesVersion; that pin must follow talosctl upgrade-k8s",
      "managerFilePatterns": ["/^infra/metal/topf\\.yaml$/"],
      "matchStrings": ["talosVersion: (?<currentValue>v\\d+\\.\\d+\\.\\d+)"],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "siderolabs/talos"
    }
  ]
}
